# mock = local demo scenarios | live = HTTP to VITE_CHAT_API_URL
VITE_CHAT_MODE=live

# Relative path (proxied in dev) or full URL to your agent
VITE_CHAT_API_URL=https://talon-agent.vercel.app/api/chat

# Dev proxy target — only when VITE_CHAT_API_URL is relative, e.g. /api/chat
VITE_CHAT_PROXY_TARGET=http://127.0.0.1:2000
